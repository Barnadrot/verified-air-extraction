  simpa only [List.all_eq_true, wordBound, decide_eq_true_eq] using C4_3wordBound

theorem C4_3length : C4_3.length = 2 := by rfl

def M4 : Module := ⟨4, [100,101,99,111,100,101,100], false, false, C4_0 ++ C4_1 ++ C4_2 ++ C4_3, ((List.range 0).map (fun n => [n]))⟩

def M4prefix : List Nat := [4,7,100,101,99,111,100,101,100,0,0,0,0,26]
theorem M4prefixwordBound : M4prefix.all wordBound = true := by decide

def M4words : List Nat := M4prefix ++ C4_0words ++ C4_1words ++ C4_2words ++ C4_3words ++ [0]

theorem M4wire : module.encode M4 = M4words := by
  rw [module_fast]
  simp only [M4,moduleWords,List.length_append,List.flatMap_append,C4_0length,C4_1length,C4_2length,C4_3length,C4_0wire,C4_1wire,C4_2wire,C4_3wire]
  rfl

theorem M4wordBound : M4words.all wordBound = true := by
  simp only [M4words,List.all_append,M4prefixwordBound,C4_0wordBound,C4_1wordBound,C4_2wordBound,C4_3wordBound]
  decide

theorem M4bounded : ∀ n ∈ M4words, n < 2^64 := by
  simpa only [List.all_eq_true,wordBound,decide_eq_true_eq] using M4wordBound

